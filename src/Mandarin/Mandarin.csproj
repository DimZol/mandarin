<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Mandarin</RootNamespace>
    <AssemblyName>Mandarin</AssemblyName>
    <Product>Mandarin</Product>
    <Description>Zero-click offline file converter for Windows 11</Description>
    <Authors>DimZol</Authors>
    <Copyright>Copyright (c) 2026 DimZol</Copyright>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\Mandarin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);WPF0001;CA1416;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Mandarin.ico" />
    <Resource Include="Assets\Mandarin.png" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Mandarin.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.5.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
