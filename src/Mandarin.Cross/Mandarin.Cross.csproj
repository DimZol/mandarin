<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mandarin for Linux and Windows 7/8: the same conversion engines as the Windows 10/11 app (linked from src/Mandarin)
    with an Avalonia interface. net10.0 is the Linux build, net6.0 the Windows 7 build (the last .NET that supports it).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net6.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mandarin</RootNamespace>
    <AssemblyName>Mandarin</AssemblyName>
    <Product>Mandarin</Product>
    <Description>Zero-click offline file converter</Description>
    <Authors>DimZol</Authors>
    <Copyright>Copyright (c) 2026 DimZol</Copyright>
    <Version>1.2.0</Version>
    <ApplicationIcon>..\Mandarin\Assets\Mandarin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);CROSS</DefineConstants>
    <!-- net6.0 is out of support, but it is the last .NET that runs on Windows 7 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);CA1416;NETSDK1138;CS8618;NU1903;NU1902</NoWarn>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- engines and core shared with the Windows 10/11 app; the Windows-only parts are replaced by Platform/* -->
    <Compile Include="..\Mandarin\Core\**\*.cs" Link="Shared\Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Mandarin\Engines\**\*.cs"
             Exclude="..\Mandarin\Engines\WinRt.cs;..\Mandarin\Engines\HtmlEngine.Print.cs;..\Mandarin\Engines\DocumentConverter.Rtf.cs"
             Link="Shared\Engines\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Mandarin\Localization\*.json" LogicalName="Mandarin.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Mandarin\Assets\Mandarin.png" LogicalName="Mandarin.Assets.Mandarin.png" />
    <EmbeddedResource Include="..\Mandarin\Assets\Mandarin.ico" LogicalName="Mandarin.Assets.Mandarin.ico" />
  </ItemGroup>

  <!-- Linux: Avalonia 12 (drag and drop on X11); Windows 7: Avalonia 11.3, the last one for .NET 6 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <DefineConstants>$(DefineConstants);AVALONIA12</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Material.Icons" Version="2.4.1" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.5.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- libraries built for .NET Standard ask for version 8 of these; .NET 6 has older ones inside -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
  </ItemGroup>

</Project>
